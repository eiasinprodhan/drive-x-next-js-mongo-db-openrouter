# ── Database ──────────────────────────────────────────────
# MongoDB Atlas connection string. If missing, the app runs in
# DEMO MODE with an in-memory store (auto-seeded), so you can
# evaluate everything without a database.
MONGODB_URI=

# ── AI (OpenRouter) ───────────────────────────────────────
# https://openrouter.ai/keys — if missing, a built-in rule-based
# AI engine takes over so every AI feature still works offline.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_MODEL_FALLBACK=openai/gpt-4o-mini

# ── Admin panel ───────────────────────────────────────────
ADMIN_PASSWORD=drivex2026
ADMIN_EMAIL=admin@drivex.io

# ── Automation integrations (all optional) ────────────────
# Team notifications via Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Automated lead emails via Resend
RESEND_API_KEY=
RESEND_FROM=DriveX <leads@drivex.io>
# External cron that pings /api/webhooks/digest (e.g. UptimeRobot, cron-job.org)
DIGEST_WEBHOOK_URL=
# Secret for authenticating webhook calls
WEBHOOK_SECRET=drivex-webhook-secret
